{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.invalid/schemas/thoth-concap-source-bindings-v1.json",
  "title": "QSOL-THOTH CONCAP Source Bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "authority",
    "roles",
    "boundaries"
  ],
  "properties": {
    "protocol": {
      "const": "QSOL-THOTH/CONCAP-SOURCE-BINDINGS/1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority": {
      "const": "resolution-metadata-only"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "source_class",
          "load_requirement",
          "delivery",
          "style_support_only",
          "factual_authority"
        ],
        "properties": {
          "role_id": {
            "type": "string",
            "pattern": "^concap\\.[a-z0-9_.-]+/[1-9][0-9]*$"
          },
          "source_class": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "load_requirement": {
            "enum": [
              "required",
              "best_effort"
            ]
          },
          "delivery": {
            "const": "portable_object"
          },
          "style_support_only": {
            "type": "boolean"
          },
          "factual_authority": {
            "const": "none-by-resolution"
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
