{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.invalid/schemas/thoth-history-dataset-v1.json",
  "title": "QSOL-THOTH Historical Reconstruction Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "schema_version", "id", "authority", "retention_obligations", "records", "boundaries"],
  "properties": {
    "protocol": {"const": "QSOL-THOTH/HISTORY-DATASET/1"},
    "schema_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "authority": {"const": "demonstration-only"},
    "retention_obligations": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9_.-]+$"}},
    "records": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","order","kind","summary","claims","requires"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9_.-]+$"},"order":{"type":"integer","minimum":1},"kind":{"enum":["detail","bridge","anchor"]},"summary":{"type":"string","minLength":1},"claims":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9_.-]+$"}},"requires":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9_.-]+$"}}}}},
    "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
