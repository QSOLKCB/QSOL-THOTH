{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.invalid/schemas/thoth-concap-registry-v1.json",
  "title": "QSOL-THOTH CONCAP Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "namespace",
    "expansion",
    "authority",
    "capsules",
    "boundaries"
  ],
  "properties": {
    "protocol": {
      "const": "QSOL-THOTH/CONCAP-REGISTRY/1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "namespace": {
      "const": "CONCAP"
    },
    "expansion": {
      "const": "CONtext CAPsules"
    },
    "authority": {
      "const": "semantic-routing-only"
    },
    "capsules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "role",
          "default_privacy",
          "epistemic_authority",
          "style_authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^concap\\.[a-z0-9_.-]+/[1-9][0-9]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "default_privacy": {
            "const": "RESTRICTED"
          },
          "epistemic_authority": {
            "const": "none-by-routing"
          },
          "style_authority": {
            "enum": [
              "none",
              "receiver-guidance"
            ]
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
