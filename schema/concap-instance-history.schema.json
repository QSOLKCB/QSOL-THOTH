{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.invalid/schemas/concap-instance-history-v1.json",
  "title": "QSOL-CAPSULES CONCAP Instance History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "record_class",
    "authority",
    "history_id",
    "snapshots",
    "boundaries"
  ],
  "properties": {
    "protocol": {
      "const": "QSOL-CAPSULES/CONCAP-INSTANCE-HISTORY/1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_class": {
      "enum": [
        "accepted-private-metadata",
        "synthetic-conformance"
      ]
    },
    "authority": {
      "const": "private-instance-metadata-only"
    },
    "history_id": {
      "$ref": "#/$defs/sha256"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"const": "INSTANCE_HISTORY != CAPSULE_BYTES"},
        {"const": "ACCEPTED_METADATA != FACTUAL_AUTHORITY"},
        {"const": "CAPSULE_PRESENT != CAPSULE_VERIFIED"},
        {"const": "SNAPSHOT_APPEND_ONLY != SOURCE_IMMUTABLE"},
        {"const": "HISTORICAL_INSTANCE != CURRENT_INSTANCE"},
        {"const": "MODEL_CAN_LOAD_EXPORT != MODEL_CAN_ACCESS_CAPSULE_REPOSITORY"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "concapId": {
      "type": "string",
      "pattern": "^concap\\.[a-z0-9_.-]+/[1-9][0-9]*$"
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "capsule_name",
        "capsule_sha256",
        "size_bytes",
        "container",
        "fixed_point_verified"
      ],
      "properties": {
        "role_id": {
          "$ref": "#/$defs/concapId"
        },
        "capsule_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*\\.dat$"
        },
        "capsule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "container": {
          "const": "qsol-restore-dat/1"
        },
        "fixed_point_verified": {
          "const": true
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "sequence",
        "predecessor_snapshot_id",
        "acceptance_status",
        "source_commit",
        "source_projection_sha256",
        "generator_commit",
        "policy_sha256",
        "verification_receipt_sha256",
        "instances"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/sha256"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_snapshot_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "acceptance_status": {
          "const": "accepted"
        },
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "source_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      }
    }
  }
}
